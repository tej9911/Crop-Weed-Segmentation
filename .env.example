# Copy to .env (or export these variables) to change how the server runs.
# All values are optional; the defaults are shown.

# "development" or "production". Production never falls back to demo mode.
APP_ENV=development

# Use the colour heuristic when no trained model is found (ignored in production).
ALLOW_DEMO_MODE=true

# Path to the trained model, relative to the project root or absolute.
# Its metrics are read from the matching .metadata.json file next to it.
MODEL_PATH=models/mt_ahnet_model.keras

# Dataset folder, used to show class counts when the model metadata has none.
DATA_DIR=data/dataset

# Server address for "python -m backend.app". Use HOST=0.0.0.0 to allow other devices.
HOST=127.0.0.1
PORT=5000

# Maximum upload size in bytes (10 MB).
MAX_UPLOAD_BYTES=10485760

# Comma-separated origins allowed to call the API from another site. Empty = same origin only.
CORS_ORIGINS=

LOG_LEVEL=INFO
